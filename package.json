{
  "name": "game-manager",
  "version": "0.5.0",
  "description": "游戏管理软件 - 管理Galgame、RPG和Unity游戏",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node scripts/check-env.js",
    "build": "electron-builder --config build/electron-builder.yml",
    "build:win": "electron-builder --config build/electron-builder.yml --win",
    "build:mac": "electron-builder --config build/electron-builder.yml --mac",
    "build:linux": "electron-builder --config build/electron-builder.yml --linux",
    "pack": "electron-builder --config build/electron-builder.yml --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Game Manager",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "archiver": "^5.3.1",
    "fs-extra": "^10.1.0"
  }
}
